# Environment variables read by the backend. Copy the values you need into your shell
# or IDE run configuration; Spring Boot does not load this file automatically.
# Never commit real secrets (.env is git-ignored).

# --- Database (native PostgreSQL; not needed for `mvnw spring-boot:test-run`) ---
DB_URL=jdbc:postgresql://localhost:5432/repointelligence
DB_USERNAME=repointel
DB_PASSWORD=repointel_dev

# --- GitHub (optional, strongly recommended) ---
# Fine-grained token with read-only access to public repositories.
# Raises the GitHub API limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# --- Analysis workspace ---
# Directory where repository snapshots are extracted during analysis.
WORKSPACE_ROOT=./.workspace
