# Environment variables read by the backend. Never commit real secrets (.env is git-ignored).
#
# Docker Compose: copy this file to `.env` in the repository root and set GITHUB_TOKEN.
#   Compose reads `.env` automatically. DB_URL and WORKSPACE_ROOT below are ignored there
#   (compose.yaml points the backend at the `postgres` container and /workspace).
#   DB_USERNAME/DB_PASSWORD are used when the database volume is first created; after that,
#   changing them needs `docker compose down -v` (which deletes the data).
# Without Docker: copy the values you need into your shell or IDE run configuration;
#   Spring Boot does not load this file automatically.

# --- Docker Compose host ports (optional; change if a port is already in use) ---
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

# --- Database (Docker Compose or native PostgreSQL; not needed for `mvnw spring-boot:test-run`) ---
DB_URL=jdbc:postgresql://localhost:5432/repointelligence
DB_USERNAME=repointel
DB_PASSWORD=repointel_dev

# --- GitHub (optional, strongly recommended) ---
# Fine-grained token with read-only access to public repositories.
# Raises the GitHub API limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# --- Analysis workspace ---
# Directory where repository snapshots are extracted during analysis.
WORKSPACE_ROOT=./.workspace

# --- Optional analysis settings (all have safe defaults; set only what you need) ---
# Known-vulnerability lookup via OSV.dev. Off by default (needs outbound network; sends package names and versions only).
ANALYSIS_VULNERABILITIES_OSV_ENABLED=false
# Command used to run Semgrep if it is not on PATH.
ANALYSIS_ANALYZERS_SEMGREP_SECURITY_ANALYZER_OPTIONS_COMMAND=semgrep
# Include test sources in PMD code-quality analysis.
ANALYSIS_ANALYZERS_JAVA_CODE_ANALYZER_OPTIONS_INCLUDE_TESTS=false
# Limits (examples; see README configuration reference)
REPOSITORY_INGESTION_MAX_REPOSITORY_SIZE_MB=200
ANALYSIS_JOBS_MAX_ANALYSIS_DURATION=PT15M

# --- AI insights (optional, MVP 3; everything is off by default) ---
# The application is fully functional without AI. With AI_ENABLED=false nothing is sent anywhere.
# Before enabling a hosted provider (Gemini, OpenRouter) verify its current terms, quotas and data use:
# repository excerpts (secrets scrubbed) are sent to it, and only after you set its
# *_DATA_HANDLING_ACKNOWLEDGED=true. Never commit real keys.
AI_ENABLED=false
AI_DEFAULT_PROVIDER=ollama
AI_MAX_CALLS_PER_ANALYSIS=10
# Local Ollama (nothing leaves the machine). Leave OLLAMA_BASE_URL unset in Docker: the compose default
# http://host.docker.internal:11434 reaches an Ollama on the host. Outside Docker the default is localhost.
AI_PROVIDERS_OLLAMA_ENABLED=false
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=
# Google Gemini (hosted)
AI_PROVIDERS_GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
AI_PROVIDERS_GEMINI_DATA_HANDLING_ACKNOWLEDGED=false
# OpenRouter (hosted)
AI_PROVIDERS_OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=
AI_PROVIDERS_OPENROUTER_DATA_HANDLING_ACKNOWLEDGED=false
